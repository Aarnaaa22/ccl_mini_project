# =============================================================================
# Cloud-Based Student Assignment Submission & Evaluation Portal
# Master Environment Variables Configuration (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Infrastructure Configuration (Backend & EC2 IAM Role Target)
# -----------------------------------------------------------------------------

# AWS Deployment Region
AWS_REGION=us-east-1

# AWS Systems Manager (SSM) Parameter Store Paths
# Securely stores MySQL RDS endpoints and credentials without hardcoding in codebase.
SSM_DB_HOST_PATH=/app/db_host
SSM_DB_USER_PATH=/app/db_user
SSM_DB_PASSWORD_PATH=/app/db_password

# AWS S3 Bucket Name for Student PDF Submissions
# Ensure bucket CORS allows PUT and GET requests from your frontend origin.
S3_BUCKET_NAME=assignment-portal-submissions-prod

# Backend Server Port (For EC2 instance / ALB listener target)
PORT=5000

# -----------------------------------------------------------------------------
# Frontend Application Configuration (React / Client)
# -----------------------------------------------------------------------------

# Target Backend API URL (EC2 Public IP, Elastic IP, or ALB DNS Name)
# Note: In Vite, this can also be aliased to VITE_API_BASE_URL
REACT_APP_API_BASE_URL=http://your-ec2-alb-dns-or-ip:5000

# -----------------------------------------------------------------------------
# Local Development Fallbacks (Optional for local testing without AWS SSM)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=assignment_portal
